    "properties": {
     "status": {
      "type": "string",
      "enum": [
       "candidates",
       "no_match",
       "recognition_failed",
       "link_unreadable",
       "search_failed"
      ],
      "title": "Status"
     },
     "groups": {
      "items": {
       "$ref": "#/components/schemas/PlaceGroup"
      },
      "type": "array",
      "title": "Groups",
      "description": "링크·스크린샷 결과 (직접 검색은 비어 있음)"
     },
     "candidates": {
      "items": {
       "$ref": "#/components/schemas/Candidate"
      },
      "type": "array",
      "title": "Candidates",
      "description": "호환용: 모든 후보를 한 줄로 (best 먼저)"
     },
     "suggested_query": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Suggested Query"
     },
     "message": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Message"
     },
     "extracted": {
      "items": {
       "$ref": "#/components/schemas/Extracted"
      },
      "type": "array",
      "title": "Extracted"
     }
    },
    "type": "object",
    "required": [
     "status"
    ],
    "title": "ResolveResult"
   },
   "SavedPlaceIn": {
    "properties": {
     "place": {
      "$ref": "#/components/schemas/Place-Input"
     },
     "source": {
      "type": "string",
      "enum": [
       "mine",
       "couple"
      ],
      "title": "Source",
      "description": "mine=내 보관함, couple=공동 보관함",
      "default": "mine"
     }
    },
    "type": "object",
    "required": [
     "place"
    ],
    "title": "SavedPlaceIn",
    "description": "백엔드가 보내는 사용자의 저장 장소 1곳 (AI 서버는 저장하지 않음)."
   },
   "Step": {
    "properties": {
     "key": {
      "type": "string",
      "title": "Key"
     },
     "label": {
      "type": "string",
      "title": "Label"
     },
     "done": {
      "type": "boolean",
      "title": "Done",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "key",
     "label"
    ],
    "title": "Step"
   },
   "TimeRange": {
    "properties": {
     "open": {
      "type": "string",
      "pattern": "^([0-3]\\d|4[0-7]):[0-5]\\d$",
      "title": "Open",
      "description": "HH:MM"
     },
     "close": {
      "type": "string",
      "pattern": "^([0-3]\\d|4[0-7]):[0-5]\\d$",
      "title": "Close",
      "description": "HH:MM, 자정 넘으면 24 이상 (예: 26:00 = 다음날 02:00)"
     }
    },
    "type": "object",
    "required": [
     "open",
     "close"
    ],
    "title": "TimeRange"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   },
   "WeeklyHours": {
    "properties": {
     "days": {
      "additionalProperties": {
       "items": {
        "$ref": "#/components/schemas/TimeRange"
       },
       "type": "array"
      },
      "type": "object",
      "title": "Days"
     },
     "breaks": {
      "additionalProperties": {
       "items": {
        "$ref": "#/components/schemas/TimeRange"
       },
       "type": "array"
      },
      "type": "object",
      "title": "Breaks"
     },
     "last_order": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Last Order"
     },
     "closed_days": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Closed Days"
     },
     "partial": {
      "type": "boolean",
      "title": "Partial",
      "description": "일부 요일/시작시간만 알려진 경우",
      "default": false
     },
     "earliest_open": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Earliest Open",
      "description": "'17:00에 영업 시작'처럼 시작 시각만 알 때"
     },
     "raw": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Raw"
     }
    },
    "type": "object",
    "title": "WeeklyHours",
    "description": "구조화된 영업시간. 요일 키가 없으면 '정보 없음', 빈 리스트면 '휴무'."
   }
  }
 }
}