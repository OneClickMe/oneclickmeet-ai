            "type": "string"
          },
          "title": "Amenities",
          "type": "array"
        },
        "stay_minutes_hint": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "본문에 '2시간 소요' 등 근거가 있을 때만",
          "title": "Stay Minutes Hint"
        },
        "indoor": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "실내면 true, 실외면 false, 모르면 null",
          "title": "Indoor"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "커플 데이트 관점 한두 문장 요약",
          "title": "Summary"
        },
        "highlights": {
          "items": {
            "type": "string"
          },
          "title": "Highlights",
          "type": "array"
        },
        "cautions": {
          "description": "웨이팅, 주차 불가 등 주의점",
          "items": {
            "type": "string"
          },
          "title": "Cautions",
          "type": "array"
        },
        "evidence": {
          "description": "근거가 된 원문 구절(짧게)",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "default": 0.5,
          "description": "이 장소 정보 전체에 대한 확신도",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "title": "ExtractedPlace",
      "type": "object"
    },
    "Menu": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "원 단위 정수",
          "title": "Price"
        }
      },
      "required": [
        "name"
      ],
      "title": "Menu",
      "type": "object"
    }
  },
  "properties": {
    "places": {
      "items": {
        "$ref": "#/$defs/ExtractedPlace"
      },
      "title": "Places",
      "type": "array"
    },
    "is_place_content": {
      "default": true,
      "description": "장소와 무관한 콘텐츠면 false",
      "title": "Is Place Content",
      "type": "boolean"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "title": "ExtractionResult",
  "type": "object"
}