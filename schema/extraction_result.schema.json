        "reservation_method": {
          "anyOf": [
            {
              "enum": [
                "naver",
                "catchtable",
                "phone",
                "dm",
                "walk_in",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reservation Method"
        },
        "est_cost_per_person": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1인 예상 비용(원). 메뉴 가격 근거가 있을 때만",
          "title": "Est Cost Per Person"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "화면에 보이는 평점",
          "title": "Rating"
        },
        "review_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Count"
        },
        "nearest_station_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "예: '압구정로데오역 5번 출구에서 534m'",
          "title": "Nearest Station Text"
        },
        "parking_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parking Text"
        },
        "amenities": {
          "description": "편의시설 예: 단체 이용 가능, 무선 인터넷",
