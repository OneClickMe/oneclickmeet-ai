{
  "$defs": {
    "ExtractedPlace": {
      "description": "콘텐츠 한 건에서 찾은 장소 하나. 확실하지 않은 값은 null.",
      "properties": {
        "name": {
          "description": "상호명/장소명. 지점명은 branch 로 분리",
          "title": "Name",
          "type": "string"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "지점명 예: 성수점",
          "title": "Branch"
        },
        "address_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "본문에 적힌 주소 그대로",
          "title": "Address Hint"
        },
        "region_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "동네/지역 단서 예: 성수, 연남동, 제주 애월",
          "title": "Region Hint"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "primary_category": {
          "default": "other",
          "enum": [
            "restaurant",
            "cafe",
            "bar",
            "culture",
            "activity",
            "nature",
            "shopping",
            "stay",
            "other"
          ],
          "title": "Primary Category",
          "type": "string"
        },
        "sub_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub Category"
        },
        "tags": {
          "description": "택소노미 태그 목록에서만",
