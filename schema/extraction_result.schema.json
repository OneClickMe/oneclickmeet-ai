        },
        "opening_hours_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "영업시간 원문 그대로(요일별이면 전부). 예: '월-금 11:30-21:00 / 토,일 12:00-22:00'",
          "title": "Opening Hours Text"
        },
        "closed_days_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
